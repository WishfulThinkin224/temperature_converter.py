"""
Celsius to Fahrenheit Converter

Accepts a Celsius temperature, validates the input,
and converts it to Fahrenheit.
"""

import math

while True:
    try:
        Celsius = float(input("Enter temperature in Celsius: ").strip())

        if not math.isfinite(Celsius):
            print("Please enter a finite temperature.")
        else:
            break

    except ValueError:
        print("Invalid input. Please enter a number.")

Fahrenheit = (Celsius * 9 / 5) + 32

print(f"\nCelsius: {Celsius:.2f}°C")
print(f"Fahrenheit: {Fahrenheit:.2f}°F")

# String manipulation examples
result = f"{Celsius:.2f} degrees Celsius equals {Fahrenheit:.2f} degrees Fahrenheit."
print(result.upper())
print(f"Number of words in the result: {len(result.split())}")
